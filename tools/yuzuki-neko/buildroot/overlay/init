#!/bin/sh
# SPDX-License-Identifier: MPL-2.0

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root TERM=vt100
export PS1='neko:\w# '
exec </dev/console >/dev/console 2>&1
mount -t devtmpfs devtmpfs /dev
mkdir -p /proc /sys /tmp /root
mount -t proc proc /proc
mount -t sysfs sysfs /sys
cd /root
echo
echo 'Asterinas RV32 / Yuzuki Neko'
echo 'Buildroot userspace with BusyBox and musl; root filesystem is in RAM.'
echo 'Type help for shell builtins, or busybox for available commands.'
# BusyBox halt/poweroff/reboot signal PID 1 unless called with -f.
trap 'exec /bin/busybox halt -f' USR1
trap 'exec /bin/busybox poweroff -f' USR2
trap 'exec /bin/busybox reboot -f' TERM
# Keep PID 1 alive and reap the interactive shell when it exits.
while true; do
    # Explicitly acquire the UART as the controlling terminal in a new session.
    setsid -c /bin/sh -i </dev/ttyS0 >/dev/ttyS0 2>&1 &
    # Waiting for an asynchronous child lets ash run the power-control traps.
    wait $!
    echo 'Shell exited; restarting.'
done
